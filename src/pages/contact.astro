---
import BaseLayout from "@layouts/BaseLayout.astro";
import { sections } from "@lib/site";
import { getWhatsAppUrl } from "@lib/enquiries";
---

<BaseLayout title="Contact" description="Contact Ash for event photography, event video, and social media content enquiries in Singapore." active="contact">
  <section class="contact-page" aria-labelledby="contact-title">
    <header class="contact-intro">
      <h1 id="contact-title">Let’s work together</h1>
      <p class="contact-lede">Enquire about photography, video, or social media content.</p>
      <div class="contact-whatsapp">
        <a class="button whatsapp-cta" href={getWhatsAppUrl()} data-contact-whatsapp data-photography-href={getWhatsAppUrl("photography")} data-video-href={getWhatsAppUrl("video")} target="_blank" rel="noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M21 11.5a9 9 0 0 1-13.4 7.8L3 21l1.6-4.7A9 9 0 1 1 21 11.5Z"/><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" d="M8 7.5c0 4 2.5 6.5 6.5 7l1-2-2-.8-.8 1c-1.7-.7-2.7-1.7-3.4-3.4l1-.8-.8-2-1.5 1Z"/></svg>
          Chat on WhatsApp <span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>
    <section class="enquiry-panel" aria-labelledby="enquiry-title">
      <header class="enquiry-heading">
        <h2 id="enquiry-title">Send an enquiry</h2>
      </header>
      <form action="https://api.web3forms.com/submit" method="POST" id="enquiry-form">
        <input type="hidden" name="access_key" value="3098e95c-eb3b-418f-92ea-87d82fb41dc2" />
        <input type="hidden" name="subject" value="New portfolio project enquiry" />
        <input type="checkbox" name="botcheck" class="botcheck" tabindex="-1" aria-hidden="true" />
        <label for="enquiry-name">Your name<input id="enquiry-name" name="name" autocomplete="name" maxlength="150" required /></label>
        <label for="enquiry-email">Contact email
          <input id="enquiry-email" type="email" name="email" autocomplete="email" maxlength="254" required />
        </label>
        <label for="enquiry-phone">Phone number
          <input id="enquiry-phone" type="tel" name="phone" autocomplete="tel" maxlength="50" placeholder="Include country code, e.g. +65" />
        </label>
        <label for="enquiry-service">What would you like to book?
          <select id="enquiry-service" name="service" required>
            <option value="" disabled selected>Select a service</option>
            <option value="photography">Photography</option>
            {sections.video && <option value="video">Video</option>}
            <option value="photo-video">Photography + video</option>
            <option value="social">Social media content</option>
          </select>
        </label>
        <label for="enquiry-timing">When do you need it?
          <span class="field-hint" id="timing-hint">Event date or delivery timeline; an estimate is fine.</span>
          <input id="enquiry-timing" name="timeline" maxlength="250" aria-describedby="timing-hint" required />
        </label>
        <label for="enquiry-budget">Estimated budget (SGD)
          <span class="field-hint" id="budget-hint">Total project budget, or monthly for ongoing social content.</span>
          <select id="enquiry-budget" name="budget" aria-describedby="budget-hint" required>
            <option value="" disabled selected>Select a budget</option>
            <option>S$600–999</option><option>S$1,000–1,499</option><option>S$1,500–2,499</option><option>S$2,500–4,999</option><option>S$5,000+</option><option>Other / I’d like a recommendation</option>
          </select>
        </label>
        <label class="form-wide" for="enquiry-message">Tell me more about your project
          <span class="field-hint" id="project-hint">Describe your event or project, where it will take place, and what you’d like me to capture or create.</span>
          <textarea id="enquiry-message" name="message" rows="4" maxlength="5000" aria-describedby="project-hint" required></textarea>
        </label>
        <button type="submit" class="button button-dark form-wide">Send enquiry</button>
        <p class="form-wide" id="enquiry-status" role="status" aria-live="polite" tabindex="-1"></p>
        <p class="form-wide" id="enquiry-error" role="alert" hidden>Couldn’t send your enquiry. Your details are still here—please try again or <a href="mailto:ashchong138@gmail.com">email me</a>.</p>
      </form>
    </section>
    <p class="contact-email-alternative">You can also email me at <a href="mailto:ashchong138@gmail.com?subject=Project%20enquiry">ashchong138@gmail.com</a>.</p>
    <dialog id="enquiry-success-dialog" aria-labelledby="enquiry-success-title" aria-describedby="enquiry-success-description">
      <h2 id="enquiry-success-title">Your enquiry has been sent</h2>
      <p id="enquiry-success-description">Thank you for getting in touch. I’ll review your enquiry and respond within 24 hours.</p>
      <button type="button" class="button button-dark" id="close-enquiry-success" autofocus>Done</button>
    </dialog>
  </section>
</BaseLayout>

<script>
  const successDialog = document.querySelector<HTMLDialogElement>("#enquiry-success-dialog");
  document.querySelector("#close-enquiry-success")?.addEventListener("click", () => successDialog?.close());
  successDialog?.addEventListener("close", () => {
    document.body.style.overflow = "";
    document.querySelector<HTMLButtonElement>('#enquiry-form button[type="submit"]')?.focus({ preventScroll: true });
  });
  const form = document.querySelector<HTMLFormElement>("#enquiry-form");
  const emailField = document.querySelector<HTMLInputElement>("#enquiry-email");
  // WHATWG HTML email syntax, equivalent to type="email" validation:
  // https://html.spec.whatwg.org/multipage/input.html#email-state-(type=email)
  const emailPattern = /^[a-zA-Z0-9.!#$%&'*+\/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*$/;
  const validateEmail = () => {
    if (!emailField) return;
    // Empty values use the browser's required-field message.
    emailField.setCustomValidity(
      emailField.value && !emailPattern.test(emailField.value)
        ? "Enter a valid email address, such as name@example.com."
        : ""
    );
  };
  emailField?.addEventListener("input", validateEmail);
  emailField?.addEventListener("blur", validateEmail);
  form?.addEventListener("reset", () => emailField?.setCustomValidity(""));
  const serviceField = document.querySelector<HTMLSelectElement>("#enquiry-service");
  const status = document.querySelector<HTMLParagraphElement>("#enquiry-status");
  const error = document.querySelector<HTMLParagraphElement>("#enquiry-error");
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    validateEmail();
    if (!form.reportValidity()) return;
    if (!status || !error || !button || button.disabled) return;
    button.disabled = true;
    button.textContent = "Sending…";
    status.textContent = "Sending your enquiry…";
    error.hidden = true;
    const controller = new AbortController();
    const timeout = window.setTimeout(() => controller.abort(), 20000);
    try {
      const response = await fetch(form.action, {
        method: "POST", body: new FormData(form), signal: controller.signal,
        headers: { Accept: "application/json" }
      });
      const result = await response.json();
      if (!response.ok || result.success !== true) throw new Error("Submission failed");
      form.reset();
      status.textContent = "";
      successDialog?.showModal();
      document.body.style.overflow = "hidden";
    } catch {
      status.textContent = "";
      error.hidden = false;
    } finally {
      window.clearTimeout(timeout);
      button.disabled = false;
      button.textContent = "Send enquiry";
    }
  });
  const whatsappLink = document.querySelector<HTMLAnchorElement>("[data-contact-whatsapp]");
  const params = new URLSearchParams(window.location.search);
  const requestedService = params.get("service");
  if (serviceField && ["photography", "video", "social"].includes(requestedService ?? "")) {
    serviceField.value = requestedService!;
  }

  if (whatsappLink && requestedService === "photography" && whatsappLink.dataset.photographyHref) {
    whatsappLink.href = whatsappLink.dataset.photographyHref;
  } else if (whatsappLink && requestedService === "video" && whatsappLink.dataset.videoHref) {
    whatsappLink.href = whatsappLink.dataset.videoHref;
  }
</script>

<style>
  .contact-page { max-width: 1040px; padding: clamp(74px, 11vw, 140px) 0 96px; text-align: left; }
  .contact-intro { margin: 0 auto clamp(48px, 6vw, 72px); text-align: center; }
  .contact-page h1 { margin: 0 auto 24px; line-height: 1.04; }
  .contact-lede { max-width: 48ch; margin: 0 auto; color: var(--muted); font-size: clamp(1.12rem, 1.6vw, 1.28rem); line-height: 1.6; }
  .contact-whatsapp { margin-top: 32px; }
  .whatsapp-cta { gap: 12px; padding: 18px 28px; min-height: 58px; background: #25d366; color: #08210f; border: 1px solid #1ea952; font-size: 1.05rem; box-shadow: 0 8px 24px rgba(18, 71, 36, .12); }
  .whatsapp-cta:hover { background: #20c35d; border-color: #16893f; }
  .whatsapp-cta svg { width: 24px; height: 24px; flex-shrink: 0; }
  .enquiry-panel { max-width: 860px; margin: 0 auto; padding: clamp(28px, 4vw, 52px); border: 1px solid rgba(23, 22, 21, .14); border-radius: 20px; background: var(--paper-bright, #fffdf7); }
  .enquiry-heading { margin-bottom: 36px; }
  .enquiry-heading h2 { margin: 0 0 16px; font-size: clamp(1.75rem, 3vw, 2.25rem); line-height: 1.15; letter-spacing: -.025em; }
  #enquiry-form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 28px; }
  #enquiry-form label { display: flex; flex-direction: column; gap: 10px; min-width: 0; font-weight: 600; line-height: 1.4; }
  .form-wide { grid-column: 1 / -1; }
  .field-hint { font-size: .85rem; font-weight: 400; line-height: 1.5; color: var(--muted); }
  #enquiry-form input:not(.botcheck), #enquiry-form select, #enquiry-form textarea {
    width: 100%; min-width: 0; box-sizing: border-box; border: 1px solid #9c978e;
    border-radius: 8px; padding: 15px; font: inherit; font-size: 16px;
    color: inherit; background: var(--paper-bright, #fffdf7); margin-top: auto;
  }
  #enquiry-form textarea { resize: vertical; }
  #enquiry-form :is(input, select, textarea, button):focus-visible, .contact-page a:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  #enquiry-form .botcheck { display: none; }
  #enquiry-form button { min-height: 56px; width: 100%; }
  #enquiry-form button:disabled { opacity: .65; cursor: wait; }
  #enquiry-status:empty { display: none; }
  #enquiry-error { margin: 0; line-height: 1.5; }
  #enquiry-error a { text-decoration: underline; }
  .contact-page > .contact-email-alternative { max-width: 860px; margin: 28px auto 0; font-size: 1rem; line-height: 1.7; text-align: center; }
  .contact-email-alternative a { font-weight: 400; text-decoration: underline; text-underline-offset: 3px; overflow-wrap: anywhere; }
  #enquiry-success-dialog { width: min(480px, calc(100vw - 32px)); max-height: calc(100dvh - 32px); box-sizing: border-box; overflow-y: auto; padding: 32px; border: 1px solid #9c978e; border-radius: 16px; color: inherit; background: var(--paper-bright, #fffdf7); text-align: center; }
  #enquiry-success-dialog::backdrop { background: rgba(0, 0, 0, .55); }
  #enquiry-success-dialog h2 { font-size: 2rem; line-height: 1.2; margin: 12px 0; }
  #enquiry-success-description { line-height: 1.6; margin-bottom: 24px; }
  @media (max-width: 620px) {
    .contact-page { padding-top: 64px; padding-bottom: 64px; }
    .contact-page h1 { font-size: 44px; }
    .whatsapp-cta { width: 100%; padding: 16px; gap: 10px; font-size: 1rem; }
    .enquiry-panel { padding: 28px 0 0; border: 0; border-top: 1px solid var(--hairline); border-radius: 0; background: transparent; }
    .enquiry-heading { margin-bottom: 28px; }
    #enquiry-form { grid-template-columns: minmax(0, 1fr); gap: 24px; }
  }
</style>
