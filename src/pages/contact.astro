---
import BaseLayout from "@layouts/BaseLayout.astro";
import { site } from "@lib/site";
---

<BaseLayout title="Contact" description="Contact Ash for event photography, social media content, and collaboration enquiries." active="contact">
  <section class="contact-page" aria-labelledby="contact-title">
    <p class="eyebrow">Contact</p>
    <h1 id="contact-title">Let's talk about your event.</h1>
    <p>For event coverage, content work, or a collaboration you have in mind, WhatsApp is the fastest way to reach me.</p>

    <div class="contact-card-grid contact-card-grid-single">
      <a class="contact-card" href={site.whatsappUrl}>
        <span class="meta-label">Contact me</span>
        <strong>Chat on WhatsApp</strong>
        <small>Best for enquiries, briefs, or just checking availability. I typically reply within the day.</small>
        <span class="contact-link-label button button-whatsapp">Open WhatsApp</span>
      </a>
    </div>

    <div class="contact-explore">
      <h2 class="contact-explore-subhead">Want to see the work first?</h2>
      <p class="contact-explore-lead">Browse recent photography and social content.</p>
      <div class="contact-explore-grid">
        <a class="contact-explore-card" href="/photography/">
          <strong>Photography</strong>
          <small>Corporate and private event coverage.</small>
          <span class="contact-explore-link">Explore photography &rarr;</span>
        </a>
        <a class="contact-explore-card" href="/content/">
          <strong>Social media</strong>
          <small>Content for brands and small businesses.</small>
          <span class="contact-explore-link">Explore social media &rarr;</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
