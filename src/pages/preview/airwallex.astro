---
import BaseLayout from "@layouts/BaseLayout.astro";
import EventFilmFeature from "@components/EventFilmFeature.astro";
import { featuredEventFilm } from "@lib/site";
---

<BaseLayout
  title="Airwallex x Ecom North event film"
  description="Standalone design preview for an Airwallex corporate event-film section."
  active="content"
>
  <div class="aw-preview-shell">
    <header class="aw-preview-intro">
      <p class="eyebrow">Standalone design preview</p>
      <h1>Homepage teaser<br /><span>→ inline event film</span></h1>
      <p>
        A clear editorial handoff from social-content work into event videography.
        Use the play control to watch the film without leaving the page.
      </p>
    </header>

    <section class="aw-preview-context" aria-labelledby="context-title">
      <div class="aw-preview-context-label">
        <p class="eyebrow">Homepage context</p>
        <p>Social content stays first. The film appears as a distinct supporting capability.</p>
      </div>

      <div class="aw-mock-social-grid" aria-label="Social-content portfolio preview">
        <div class="aw-mock-reel aw-mock-reel-corporate">
          <span>Corporate</span>
          <strong>Short-form<br />campaign</strong>
          <small>500k+ views</small>
        </div>
        <div class="aw-mock-reel aw-mock-reel-lifestyle">
          <span>Lifestyle</span>
          <strong>Creator-led<br />storytelling</strong>
          <small>10k+ likes</small>
        </div>
        <div class="aw-mock-reel aw-mock-reel-property">
          <span>Real estate</span>
          <strong>Social-first<br />showcase</strong>
          <small>Vertical video</small>
        </div>
      </div>

      <div class="aw-teaser-wrap">
        <EventFilmFeature {...featuredEventFilm} loading="eager" />
      </div>
    </section>

    <section class="aw-preview-notes" aria-labelledby="notes-title">
      <div>
        <p class="eyebrow">What this pattern solves</p>
        <h2 id="notes-title">The social page stays focused. The film gets its own frame.</h2>
      </div>
      <p>
        The dark section creates a deliberate change of pace after the social reels. The headline establishes the event
        context first, then the wide film gives visitors a direct way to experience the work.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .aw-preview-shell {
    width: min(var(--max), calc(100% - var(--gutter) * 2));
    margin: 0 auto;
    padding: clamp(48px, 7vw, 94px) 0 clamp(74px, 10vw, 134px);
  }

  .aw-preview-intro {
    max-width: 850px;
    margin: 0 auto clamp(54px, 8vw, 98px);
    text-align: center;
  }

  .aw-preview-intro .eyebrow,
  .aw-preview-notes .eyebrow {
    margin-bottom: 20px;
  }

  .aw-preview-intro h1 {
    margin-bottom: 26px;
    font-size: clamp(52px, 7.3vw, 94px);
    letter-spacing: -0.075em;
  }

  .aw-preview-intro h1 span {
    color: var(--muted);
  }

  .aw-preview-intro > p:last-child {
    max-width: 620px;
    margin: 0 auto;
    font-size: clamp(1.05rem, 1.6vw, 1.26rem);
  }

  .aw-preview-context {
    padding: 0;
}

  .aw-preview-context-label {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: clamp(30px, 4vw, 48px);
  }

  .aw-preview-context-label p {
    margin: 0;
  }

  .aw-preview-context-label .eyebrow {
    flex: 0 0 auto;
  }

  .aw-preview-context-label p:last-child {
    max-width: 430px;
    font-size: 0.98rem;
    text-align: right;
  }

  .aw-mock-social-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(14px, 2.5vw, 28px);
    max-width: 820px;
    margin: 0 auto;
  }

  .aw-mock-reel {
    display: flex;
    min-height: clamp(250px, 31vw, 420px);
    flex-direction: column;
    justify-content: space-between;
    border: 1px solid rgba(255, 250, 241, 0.25);
    border-radius: 28px;
    padding: 20px;
    color: var(--paper-bright);
    box-shadow: 0 20px 48px rgba(40, 33, 25, 0.13);
  }

  .aw-mock-reel span,
  .aw-mock-reel small {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .aw-mock-reel strong {
    font-size: clamp(1.55rem, 3vw, 2.7rem);
    letter-spacing: -0.065em;
    line-height: 0.94;
  }

  .aw-mock-reel small {
    letter-spacing: 0.08em;
    opacity: 0.72;
  }

  .aw-mock-reel-corporate {
    background: linear-gradient(150deg, #20433f 0%, #6e806d 48%, #c8a873 100%);
  }

  .aw-mock-reel-lifestyle {
    background: linear-gradient(150deg, #ad6e55 0%, #d6ad8a 52%, #e7ddc9 100%);
  }

  .aw-mock-reel-property {
    background: linear-gradient(150deg, #1f2731 0%, #536676 52%, #c5b39d 100%);
  }

  .aw-teaser-wrap {
    position: relative;
    isolation: isolate;
    max-width: 1180px;
    margin: clamp(48px, 7vw, 86px) auto 0;
    padding: clamp(46px, 7vw, 84px) clamp(22px, 5vw, 72px);
  }

  .aw-teaser-wrap::before {
    position: absolute;
    inset-block: 0;
    left: 50%;
    z-index: -1;
    width: 100vw;
    content: "";
    background: var(--charcoal);
    transform: translateX(-50%);
  }

  .aw-preview-notes {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.7fr);
    gap: clamp(28px, 7vw, 100px);
    align-items: end;
    max-width: 1180px;
    margin: clamp(74px, 10vw, 136px) auto 0;
    padding-top: 34px;
    border-top: 1px solid var(--hairline);
  }

  .aw-preview-notes h2 {
    max-width: 650px;
    margin: 0;
    font-size: clamp(2rem, 4.2vw, 3.8rem);
    letter-spacing: -0.075em;
  }

  .aw-preview-notes > p {
    max-width: 360px;
    margin: 0;
    font-size: 1.04rem;
  }

  @media (max-width: 980px) {
    .aw-preview-context-label,
    .aw-preview-notes {
      display: block;
    }

    .aw-preview-context-label p:last-child {
      max-width: 440px;
      margin-top: 12px;
      text-align: left;
    }

    .aw-mock-social-grid {
      gap: 10px;
    }

    .aw-mock-reel {
      min-height: 230px;
      padding: 14px;
      border-radius: 20px;
    }

    .aw-mock-reel strong {
      font-size: clamp(1.22rem, 5vw, 1.7rem);
    }

    .aw-preview-notes > p {
      margin-top: 22px;
    }
  }

  @media (max-width: 720px) {
    .aw-mock-social-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .aw-mock-reel {
      min-height: 150px;
    }
  }

  @media (max-width: 520px) {
    .aw-preview-shell {
      width: min(100% - 28px, var(--max));
      padding-top: 40px;
    }

    .aw-preview-intro h1 {
      font-size: clamp(46px, 14vw, 74px);
    }

    .aw-mock-reel {
      min-height: 190px;
      border-radius: 18px;
    }

    .aw-mock-reel span,
    .aw-mock-reel small {
      font-size: 0.58rem;
      letter-spacing: 0.1em;
    }

    .aw-mock-reel strong {
      font-size: 1.08rem;
    }
  }
</style>
