---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import TestimonialsSection from "@components/TestimonialsSection.astro";
import WhatToExpectSection from "@components/WhatToExpectSection.astro";
import WorkGrid from "@components/WorkGrid.astro";
import { photographyTypeName, published } from "@lib/content";
import { entrySlug } from "@lib/content";
import { getGalleryCover } from "@lib/gallery-images";
import { rankPhotographyForAll, rankPhotographyForCategory } from "@lib/content";
import { pricing } from "@lib/site";

const photographyRows = [
  { label: "Pricing", value: `Coverage starts from $${pricing.photography.halfDay} for half-day events (2-3hr), $${pricing.photography.fullDay} for full-day.` },
  { label: "Deliverables", value: "Every gallery includes 60-100 edited images and a private online gallery to share or download from." },
  { label: "Turnaround", value: "Edited galleries are delivered within 5 business days." },
  { label: "Booking", value: "Weekend and peak-season dates book out fast — reach out at least 2 weeks ahead if you can." },
  { label: "Usage", value: "Images are yours to use for marketing, recaps, and future promotion." }
];

const photos = published(await getCollection("photography"));
const allPhotos = rankPhotographyForAll(photos);
const visibleCoverPhoto = allPhotos.find((photo) => !photo.data.hidden);
const pageCover = visibleCoverPhoto
  ? getGalleryCover(entrySlug(visibleCoverPhoto), visibleCoverPhoto.data.coverImage, visibleCoverPhoto.data.images, visibleCoverPhoto.data.coverImageIndex, "medium")
  : "";
const defaultPhotographyType = "all";
const photographySections = [
  {
    id: "all",
    label: "All",
    items: allPhotos
  },
  {
    id: "corporate-private-events",
    label: photographyTypeName("corporate-private-events"),
    items: rankPhotographyForCategory(photos.filter((photo) => photo.data.photographyType === "corporate-private-events"))
  },
  {
    id: "stage-work",
    label: photographyTypeName("stage-work"),
    items: rankPhotographyForCategory(photos.filter((photo) => photo.data.photographyType === "stage-work"))
  },
  {
    id: "photoshoot",
    label: photographyTypeName("photoshoot"),
    items: rankPhotographyForCategory(photos.filter((photo) => photo.data.photographyType === "photoshoot"))
  },
  {
    id: "wedding-rom",
    label: photographyTypeName("wedding-rom"),
    items: rankPhotographyForCategory(photos.filter((photo) => photo.data.photographyType === "wedding-rom"))
  }
];
---

<BaseLayout title="Photography" description="Corporate and private event photography in Singapore, covering conferences, workshops, celebrations, and everything in between." active="photography" image={pageCover}>
  <section class="page-hero photography-page-hero" aria-labelledby="photography-title">
    <p class="eyebrow">Photography</p>
    <h1 id="photography-title">Your event, captured the way it deserves.</h1>
    <p>From large conferences to intimate celebrations, I bring the same care and professional eye to every shoot.</p>
    <p>Corporate and private events are my focus. I also take on creative portrait and celebration work when the story's a good one.</p>
  </section>

  <section class="gallery-index-section photography-browser" aria-label="Photography galleries">
    <div class="curation-view-label" aria-hidden="true">Curation view</div>
    <div class="photography-tabs" role="tablist" aria-label="Photography categories">
      {
        photographySections.map((section) => (
          <button
            class:list={["photography-tab", { "is-active": section.id === defaultPhotographyType }]}
            type="button"
            role="tab"
            aria-selected={section.id === defaultPhotographyType ? "true" : "false"}
            aria-controls={`photography-panel-${section.id}`}
            id={`photography-tab-${section.id}`}
            data-photography-tab={section.id}
          >
            {section.label}
          </button>
        ))
      }
    </div>
    {
      photographySections.map((section) => (
        <section
          class="photography-panel"
          id={`photography-panel-${section.id}`}
          role="tabpanel"
          aria-labelledby={`photography-tab-${section.id}`}
          data-photography-panel={section.id}
          hidden={section.id !== defaultPhotographyType}
        >
          {section.items.length > 0 ? <WorkGrid items={section.items} /> : <p class="empty-gallery-note">No published galleries in this section yet.</p>}
        </section>
      ))
    }
  </section>

  <TestimonialsSection />
  <WhatToExpectSection id="what-to-expect" rows={photographyRows} />

  <script>
    const tabs = Array.from(document.querySelectorAll<HTMLElement>("[data-photography-tab]"));
    const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-photography-panel]"));

    function selectPhotographySection(id: string) {
      tabs.forEach((tab) => {
        const isActive = tab.dataset.photographyTab === id;
        tab.classList.toggle("is-active", isActive);
        tab.setAttribute("aria-selected", String(isActive));
      });

      panels.forEach((panel) => {
        panel.hidden = panel.dataset.photographyPanel !== id;
      });
    }

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => selectPhotographySection(tab.dataset.photographyTab || "all"));
    });
  </script>

  <section class="page-cta" aria-labelledby="photo-contact-title">
    <h2 id="photo-contact-title">Got an event worth capturing well?</h2>
    <p>Conferences, workshops, networking sessions, or a milestone that matters to you. I'd love to help you cover it.</p>
    <a class="button button-dark" href="/contact/">Let's talk</a>
  </section>
</BaseLayout>
