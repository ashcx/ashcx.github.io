---
import BaseLayout from "@layouts/BaseLayout.astro";
import BookingProcess from "@components/BookingProcess.astro";
import BookingPrompt from "@components/BookingPrompt.astro";
import EventFilmFeature from "@components/EventFilmFeature.astro";
import { featuredEventFilm } from "@lib/site";

const eventFilms = [
  {
    id: "SHuhZGxQrjg",
    title: "The Retail Growth Playbook",
    description: "Retail leaders discuss what it takes to grow beyond Singapore without losing sight of margins. Speaker perspectives and footage from the Airwallex and Singapore Retailers Association session connect the practical lessons with the energy of the room."
  },
  {
    id: "LffdpeBkFVk",
    title: "Beyond Borders",
    description: "Growth across borders starts with people sharing what they know. This recap brings together voices from Airwallex, SleekFlow, and ReturnHelper with candid conversations from the e-commerce community."
  }
];
---

<BaseLayout
  title="Event Videography Singapore | Ash Chong"
  description="Highlight films, interviews, and full speech recordings for conferences, company gatherings, and private celebrations in Singapore."
  active="video"
  fullTitle
  image={featuredEventFilm.posterUrl}
>
  <section class="page-hero video-page-hero" aria-labelledby="video-page-title">
    <p class="eyebrow">Event video</p>
    <h1 id="video-page-title">Your event, in motion.</h1>
    <p>Highlight films, interviews, and full speech recordings for conferences, company gatherings, and private celebrations in Singapore.</p>
  </section>

  <section class="video-work" aria-label="Featured event film">
    <div class="video-work-inner">
      <EventFilmFeature {...featuredEventFilm} id="ecom-north-film-title" loading="lazy" />

      <div class="video-film-context">
        <h2>My role</h2>
        <p>I handled the production from planning through to delivery. Before the shoot, I planned the coverage around the event programme; on the day, I filmed the people, conversations, and atmosphere. I then selected and edited the footage into a highlight film and prepared the finished video for delivery.</p>
      </div>
    </div>
  </section>

  <section class="video-other-work" aria-labelledby="video-other-work-title">
    <div class="video-other-work-inner">
      <h2 id="video-other-work-title">More event films</h2>
      <div class="video-film-grid">
        {eventFilms.map((film) => (
          <article class="video-film-card" aria-labelledby={`film-${film.id}-title`}>
            <div class="video-film-media" data-video-player data-video-id={film.id}>
              <img
                src={`https://i.ytimg.com/vi/${film.id}/hqdefault.jpg`}
                alt=""
                loading="lazy"
                decoding="async"
              />
              <button type="button" data-video-play aria-label={`Play ${film.title}`}>
                <span class="video-film-play-icon" aria-hidden="true"></span>
              </button>
            </div>
            <div class="video-film-copy">
              <h3 id={`film-${film.id}-title`}>{film.title}</h3>
              <p>{film.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="video-scope" aria-labelledby="video-scope-title">
    <div class="video-scope-inner">
      <h2 id="video-scope-title">What would you like to capture?</h2>
      <div class="video-service-grid">
        <article>
          <h3>Highlight films</h3>
          <p>Bring the key moments, people, and atmosphere together in one edited film.</p>
        </article>
        <article>
          <h3>Interviews</h3>
          <p>Give speakers, guests, or your team space to share their perspective.</p>
        </article>
        <article>
          <h3>Full speech recordings</h3>
          <p>Keep a complete record of a presentation or speech for later viewing.</p>
        </article>
      </div>

      <div class="video-planning-note">
        <p>We’ll agree the video length, filming format, turnaround, and revisions before booking. Filming is planned for horizontal or vertical use; if you need both, or photography alongside video, include that in your enquiry.</p>
      </div>
    </div>
  </section>

  <BookingProcess />
  <BookingPrompt variant="video" />
</BaseLayout>

<script is:inline>
  document.querySelectorAll("[data-video-player]").forEach((player) => {
    const button = player.querySelector("[data-video-play]");
    const videoId = player.getAttribute("data-video-id");

    if (!button || !videoId) return;

    button.addEventListener("click", () => {
      const frame = document.createElement("iframe");
      frame.title = button.getAttribute("aria-label")?.replace(/^Play /, "") || "Event film";
      frame.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(videoId)}?autoplay=1&playsinline=1&rel=0`;
      frame.loading = "lazy";
      frame.allow = "autoplay; encrypted-media; picture-in-picture";
      frame.allowFullscreen = true;
      frame.referrerPolicy = "strict-origin-when-cross-origin";
      player.replaceChildren(frame);
      player.setAttribute("data-loaded", "true");
    }, { once: true });
  });
</script>

<style>
  .video-page-hero.page-hero {
    padding-bottom: clamp(58px, 8vw, 88px);
    text-align: center;
  }

  .video-page-hero.page-hero h1,
  .video-page-hero.page-hero > .eyebrow,
  .video-page-hero.page-hero > p:not(.eyebrow) {
    margin-inline: auto;
  }

  .video-page-hero.page-hero h1 {
    max-width: 1040px;
  }

  .video-page-hero.page-hero > p:not(.eyebrow) {
    max-width: 720px;
  }

  .video-work {
    position: relative;
    isolation: isolate;
    width: 100%;
    padding: clamp(66px, 8vw, 104px) max(var(--gutter), calc((100vw - var(--max)) / 2));
  }

  .video-work::before {
    position: absolute;
    inset-block: 0;
    left: 50%;
    z-index: -1;
    width: 100vw;
    transform: translateX(-50%);
    background: var(--charcoal);
    content: "";
  }

  .video-work-inner {
    width: min(100%, var(--max));
    margin: 0 auto;
  }

  .video-work-inner :global(.event-film-feature) {
    max-width: 1180px;
    margin: 0 auto;
  }

  .video-work-inner :global(.event-film-intro h2) {
    letter-spacing: -0.025em;
  }

  .video-film-context {
    width: min(100%, 720px);
    margin: clamp(32px, 4vw, 46px) auto 0;
    border-top: 1px solid rgba(255, 250, 241, 0.2);
    padding-top: 22px;
    color: var(--paper-bright);
    text-align: center;
  }

  .video-film-context h2 {
    margin: 0 0 12px;
    color: var(--paper-bright);
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .video-film-context p {
    margin: 0;
    color: rgba(255, 250, 241, 0.78);
    line-height: 1.55;
    text-align: left;
  }

  .video-other-work {
    position: relative;
    isolation: isolate;
    width: 100%;
    padding: clamp(68px, 8vw, 104px) max(var(--gutter), calc((100vw - var(--max)) / 2));
  }

  .video-other-work::before {
    position: absolute;
    inset-block: 0;
    left: 50%;
    z-index: -1;
    width: 100vw;
    transform: translateX(-50%);
    background: var(--paper);
    content: "";
  }

  .video-other-work-inner {
    width: min(100%, var(--max));
    margin: 0 auto;
  }

  .video-other-work h2,
  .video-scope h2 {
    max-width: 820px;
    margin: 0 auto clamp(30px, 4vw, 44px);
    font-size: clamp(2rem, 4vw, 3rem);
    letter-spacing: -0.025em;
    line-height: 1.08;
    text-align: center;
    text-wrap: balance;
  }

  .video-film-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(24px, 4vw, 54px);
  }

  .video-film-card {
    min-width: 0;
  }

  .video-film-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid rgba(23, 22, 21, 0.12);
    border-radius: clamp(14px, 1.6vw, 22px);
    background: var(--charcoal);
  }

  .video-film-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }

  .video-film-media :global(iframe) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video-film-media img {
    opacity: 0.92;
    transition: transform 400ms ease;
  }

  .video-film-card:hover .video-film-media img {
    transform: scale(1.025);
  }

  .video-film-media::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 35%, rgba(0, 0, 0, 0.24));
    content: "";
    pointer-events: none;
  }

  .video-film-media[data-loaded]::after {
    display: none;
  }

  .video-film-media button {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    border: 0;
    padding: 0;
    background: transparent;
    cursor: pointer;
  }

  .video-film-play-icon {
    display: grid;
    width: clamp(54px, 6vw, 68px);
    height: clamp(54px, 6vw, 68px);
    place-items: center;
    border-radius: 50%;
    background: rgba(255, 250, 241, 0.95);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
  }

  .video-film-play-icon::after {
    width: 0;
    height: 0;
    margin-left: 4px;
    border-top: 8px solid transparent;
    border-bottom: 8px solid transparent;
    border-left: 13px solid var(--charcoal);
    content: "";
  }

  .video-film-media button:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: -6px;
  }

  .video-film-copy {
    padding-top: 20px;
    text-align: left;
  }

  .video-film-copy h3 {
    margin: 0 0 10px;
    font-size: clamp(1.35rem, 2.1vw, 1.7rem);
    letter-spacing: -0.02em;
    line-height: 1.12;
  }

  .video-film-copy > p:last-child {
    max-width: 560px;
    margin: 0;
    line-height: 1.55;
  }

  .video-scope {
    position: relative;
    isolation: isolate;
    width: 100%;
    padding: 0 max(var(--gutter), calc((100vw - var(--max)) / 2)) clamp(72px, 9vw, 112px);
  }

  .video-scope::before {
    position: absolute;
    inset-block: 0;
    left: 50%;
    z-index: -1;
    width: 100vw;
    transform: translateX(-50%);
    background: var(--paper);
    content: "";
  }

  .video-scope-inner {
    width: min(100%, var(--max));
    margin: 0 auto;
  }

  .video-scope h2 {
    margin-bottom: clamp(28px, 4vw, 40px);
  }

  .video-service-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 36px);
  }

  .video-service-grid article {
    border-top: 1px solid var(--hairline);
    padding-top: 18px;
    text-align: left;
  }

  .video-service-grid h3 {
    margin: 0 0 12px;
    font-size: clamp(1.15rem, 1.8vw, 1.4rem);
    letter-spacing: -0.015em;
    line-height: 1.16;
  }

  .video-service-grid p,
  .video-planning-note p {
    margin: 0;
    line-height: 1.55;
  }

  .video-planning-note {
    max-width: 760px;
    margin: clamp(36px, 5vw, 58px) auto 0;
    border-top: 1px solid var(--hairline);
    padding-top: 22px;
    text-align: left;
  }

  @media (max-width: 700px) {
    .video-film-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 34px;
    }

    .video-service-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }

    .video-film-context {
      margin-top: 30px;
      padding-top: 18px;
    }

    .video-other-work h2,
    .video-scope h2 {
      margin-bottom: 28px;
    }
  }
</style>
