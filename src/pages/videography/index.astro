---
import BaseLayout from "@layouts/BaseLayout.astro";
import BookingProcess from "@components/BookingProcess.astro";
import BookingPrompt from "@components/BookingPrompt.astro";
import EventFilmFeature from "@components/EventFilmFeature.astro";
import { featuredEventFilm } from "@lib/site";

const scopeRows = [
  {
    label: "Coverage",
    value: "Coverage is quoted around your programme, venue, and the moments you need captured."
  },
  {
    label: "Services",
    value: "Highlight films, interviews, and full speech recordings can be scoped around your event."
  },
  {
    label: "Finished edit",
    value: "The quote sets out the finished video, its length, and the agreed delivery format."
  },
  {
    label: "Format",
    value: "Filming is planned for either horizontal or vertical video, depending on where it will be used. If you need both, include that in your brief so we can agree the approach and scope."
  },
  {
    label: "Delivery and revisions",
    value: "Turnaround and included revisions are agreed as part of the project scope."
  },
  {
    label: "Photography and video",
    value: "If you need both, share the brief so we can establish whether additional crew would be needed."
  }
];
---

<BaseLayout
  title="Event Videography Singapore | Ash Chong"
  description="Event highlight films for conferences, company gatherings, and private celebrations in Singapore. View Ash Chong's event video work and discuss your brief."
  active="video"
  fullTitle
  image={featuredEventFilm.posterUrl}
>
  <section class="page-hero video-page-hero" aria-labelledby="video-page-title">
    <p class="eyebrow">Event Video</p>
    <h1 id="video-page-title">Event films that bring people back to the moment.</h1>
    <p>Highlight films, interviews, and full speech recordings for events in Singapore. Share your programme and how you plan to use the video, and we can discuss the coverage and finished edit.</p>
  </section>

  <section class="video-work" aria-labelledby="ecom-north-film-title">
    <div class="video-work-inner">
      <EventFilmFeature {...featuredEventFilm} description="" id="ecom-north-film-title" loading="lazy" />

      <div class="video-film-context">
        <h3>About this film</h3>
        <p>Airwallex's Ecom North Singapore Summit brought together retail and e-commerce operators. This film captures the people, conversations, and atmosphere of the event.</p>
        <dl>
          <div>
            <dt>My contribution</dt>
            <dd>Planning, filming, editing, and delivery.</dd>
          </div>
        </dl>
      </div>

      <div class="video-other-work">
        <h2 class="video-other-work-heading">More video work for Airwallex</h2>
        <article>
          <h3>The Retail Growth Playbook</h3>
          <p>An event film for Airwallex and the Singapore Retailers Association, centred on retail growth and cross-border expansion.</p>
          <a href="https://www.youtube.com/watch?v=SHuhZGxQrjg">Watch The Retail Growth Playbook</a>
        </article>
        <article>
          <h3>Beyond Borders</h3>
          <p>A community-focused event film about partnerships and growing across borders.</p>
          <a href="https://www.youtube.com/watch?v=LffdpeBkFVk">Watch Beyond Borders</a>
        </article>
      </div>
    </div>
  </section>

  <section class="video-scope" aria-labelledby="video-scope-title">
    <h2 id="video-scope-title">Agree the details before the shoot.</h2>
    <dl>
      {scopeRows.map((row) => (
        <div>
          <dt>{row.label}</dt>
          <dd>{row.value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <BookingProcess />
  <BookingPrompt variant="video" />
</BaseLayout>

<style>
  .video-page-hero {
    padding-bottom: clamp(58px, 8vw, 88px);
  }

  .video-work {
    position: relative;
    isolation: isolate;
    width: 100%;
    padding: clamp(66px, 8vw, 104px) max(var(--gutter), calc((100vw - var(--max)) / 2));
  }

  .video-work::before {
    position: absolute;
    inset-block: 0;
    left: 50%;
    z-index: -1;
    width: 100vw;
    transform: translateX(-50%);
    background: var(--charcoal);
    content: "";
  }

  .video-work-inner {
    width: min(100%, var(--max));
    margin: 0 auto;
  }

  .video-other-work-heading {
    grid-column: 1 / -1;
    max-width: 900px;
    margin: 0 auto -8px;
    color: var(--paper-bright);
    font-size: clamp(2rem, 4vw, 3.25rem);
    letter-spacing: -0.045em;
    line-height: 1.04;
    text-align: center;
    text-wrap: balance;
  }

  .video-work-inner :global(.event-film-feature) {
    max-width: 1180px;
    margin: 0 auto;
  }

  .video-film-context {
    max-width: 760px;
    margin: clamp(38px, 5vw, 58px) auto 0;
    border-top: 1px solid rgba(255, 250, 241, 0.18);
    padding-top: 26px;
    color: var(--paper-bright);
    text-align: center;
  }

  .video-film-context h3 {
    margin: 0 0 14px;
    font-size: 1.1rem;
  }

  .video-film-context > p {
    margin: 0 auto 24px;
    color: rgba(255, 250, 241, 0.74);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .video-film-context dl {
    margin: 0;
  }

  .video-film-context dl div {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .video-film-context dt {
    color: rgba(255, 250, 241, 0.58);
    font-weight: 750;
  }

  .video-film-context dd {
    margin: 0;
  }

  .video-other-work {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(22px, 4vw, 54px);
    max-width: 980px;
    margin: clamp(54px, 7vw, 78px) auto 0;
  }

  .video-other-work article {
    border-top: 1px solid rgba(255, 250, 241, 0.28);
    padding-top: 22px;
    color: var(--paper-bright);
  }

  .video-other-work article h3 {
    margin: 0 0 12px;
    font-size: clamp(1.2rem, 2.1vw, 1.55rem);
  }

  .video-other-work p {
    margin: 0 0 18px;
    color: rgba(255, 250, 241, 0.72);
    line-height: 1.55;
  }

  .video-other-work a {
    color: var(--paper-bright);
    font-weight: 750;
    text-underline-offset: 5px;
  }

  .video-other-work a:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 4px;
  }

  .video-scope {
    width: min(900px, calc(100% - var(--gutter) * 2));
    margin: 0 auto;
    padding: clamp(62px, 8vw, 96px) 0 0;
  }

  .video-scope h2 {
    margin-bottom: clamp(28px, 4vw, 44px);
    text-align: center;
  }

  .video-scope dl {
    margin: 0;
  }

  .video-scope dl > div {
    display: grid;
    grid-template-columns: 190px minmax(0, 1fr);
    gap: 22px;
    border-top: 1px solid var(--hairline);
    padding: 20px 0;
  }

  .video-scope dt {
    color: var(--muted);
    font-size: 0.76rem;
    font-weight: 760;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .video-scope dd {
    margin: 0;
    color: var(--ink);
    line-height: 1.55;
  }

  @media (max-width: 700px) {
    .video-other-work {
      grid-template-columns: minmax(0, 1fr);
    }

    .video-scope dl > div {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }
  }
</style>
