---
import { site } from "@lib/site";
---

<section class="home-contact" aria-labelledby="home-contact-title">
  <p class="eyebrow">Get in touch</p>
  <h2 id="home-contact-title">Got an event coming up? Let's talk.</h2>
  <p>Whether it's a full-day conference or a single product shoot, drop me a message on WhatsApp. No brief too small, no ask too big.</p>
  <div class="contact-actions">
    <a class="button button-whatsapp" href={site.whatsappUrl}>Chat on WhatsApp</a>
  </div>
</section>
