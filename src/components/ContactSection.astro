---
import { site } from "@lib/site";
---

<section class="home-contact" aria-labelledby="home-contact-title">
  <p class="eyebrow">Contact</p>
  <h2 id="home-contact-title">For shoots, collaborations, or analytics work.</h2>
  <p>Reach me directly through WhatsApp. The dedicated contact page keeps this link accessible without cluttering the photography and data pages.</p>
  <div class="contact-actions">
    <a class="button button-whatsapp" href={site.whatsappUrl}>Message on WhatsApp</a>
  </div>
</section>
