---
interface Row {
  label: string;
  value: string;
}

interface Props {
  id: string;
  rows: Row[];
  eyebrow?: string;
  heading?: string;
  intro?: string;
}

const { id, rows, eyebrow = "What to expect", heading = "Good to know before you reach out.", intro } = Astro.props;
---

<section class="wtx-section" id={id} aria-labelledby={`${id}-title`}>
  <div class="content-section-rule" />
  <div class="home-section-heading">
    <p class="eyebrow">{eyebrow}</p>
    <div>
      <h2 id={`${id}-title`}>{heading}</h2>
    </div>
  </div>
  {intro && <p class="wtx-intro">{intro}</p>}
  <dl class="wtx-rows">
    {
      rows.map((row) => (
        <div class="wtx-row">
          <dt>{row.label}</dt>
          <dd>{row.value}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .wtx-intro {
    max-width: 680px;
    margin: 20px auto 24px;
    color: var(--muted);
    line-height: 1.6;
    text-align: center;
  }
</style>
