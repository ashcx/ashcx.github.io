---
interface Props {
  html: string;
  platform: string;
  variant?: "home" | "content";
}
const { html, platform, variant = "content" } = Astro.props;
---

<div class={variant === "home" ? "home-social-embed" : "native-embed"} data-social-embed={platform}>
  {platform === "instagram" ? (
    <template><Fragment set:html={html} /></template>
  ) : (
    <Fragment set:html={html} />
  )}
</div>

<script>
  type EmbedWindow = Window & {
    instgrm?: { Embeds: { process: () => void } };
  };
  const scripts = new Map<string, Promise<void>>();
  function loadScript(src: string) {
    if (!scripts.has(src)) {
      const pending = new Promise<void>((resolve, reject) => {
        const script = document.createElement("script");
        script.src = src;
        script.async = true;
        script.onload = () => resolve();
        script.onerror = () => {
          script.remove();
          scripts.delete(src);
          reject(new Error("Social embed unavailable"));
        };
        document.head.appendChild(script);
      });
      scripts.set(src, pending);
    }
    return scripts.get(src)!;
  }

  async function activate(root: HTMLElement) {
    // TikTok's script scans the document on startup. Preserve its existing
    // rendering behaviour; Instagram supports processing newly inserted cards.
    if (root.dataset.socialEmbed === "tiktok") {
      await loadScript("https://www.tiktok.com/embed.js").catch(() => {});
      return;
    }
    const template = root.querySelector("template");
    if (!template || root.dataset.loading) return;
    root.dataset.loading = "true";
    root.appendChild(template.content.cloneNode(true));
    try {
      await loadScript("https://www.instagram.com/embed.js");
      (window as EmbedWindow).instgrm?.Embeds.process();
      template.remove();
      root.dataset.loaded = "true";
    } catch {
      // Keep the original-post link usable if the provider is blocked/offline.
      root.querySelectorAll(":scope > :not(template)").forEach((node) => node.remove());
    } finally {
      delete root.dataset.loading;
    }
  }

  const roots = document.querySelectorAll<HTMLElement>("[data-social-embed]");
  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) void activate(entry.target as HTMLElement);
      });
    }, { rootMargin: "800px 0px" });
    roots.forEach((root) => observer.observe(root));
  } else {
    // Older browsers still get embeds; hidden cards wait until revealed.
    const reveal = () => roots.forEach((root) => {
      if (root.getClientRects().length) void activate(root);
    });
    requestAnimationFrame(reveal);
    const observer = new MutationObserver(reveal);
    document.querySelectorAll("[data-progressive-list]").forEach((root) =>
      observer.observe(root, { attributes: true, attributeFilter: ["hidden"], subtree: true })
    );
  }
</script>
