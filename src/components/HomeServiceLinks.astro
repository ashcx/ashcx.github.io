---
import { sections } from "@lib/site";

const services = [
  {
    enabled: sections.photography,
    label: "Photography",
    description: "Corporate events, private celebrations, and portraits.",
    href: "#corporate-work",
    image: "/media/services/photography.webp"
  },
  {
    enabled: sections.video,
    label: "Event video",
    description: "Highlight films capturing the people and atmosphere.",
    href: "#event-video",
    image: "/media/services/event-video.webp"
  },
  {
    enabled: sections.content,
    label: "Social media",
    description: "Short videos for brands, creators, and businesses.",
    href: "#social-media",
    image: "/media/services/social-media.webp"
  }
].filter((service) => service.enabled);
---

{services.length > 0 && (
  <section id="services" class="home-services" aria-labelledby="home-services-title">
    <h2 id="home-services-title">What I do</h2>
    <nav class="home-service-links" aria-label="Explore my services">
      {services.map((service) => (
        <a class="service-link" href={service.href}>
          <picture>
            <source media="(max-width: 620px)" srcset={service.image.replace(".webp", "-mobile.webp")} />
            <img src={service.image} alt="" width="960" height="600" loading="lazy" decoding="async" />
          </picture>
          <div class="service-copy">
            <h3>{service.label}</h3>
            <p>{service.description}</p>
          </div>
          <svg class="service-arrow" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
            <path d="M12 4v16m-6-6 6 6 6-6" />
          </svg>
        </a>
      ))}
    </nav>
  </section>
)}

<style>
  .home-services {
    width: min(var(--max), calc(100% - var(--gutter) * 2));
    margin: 0 auto;
    padding: clamp(12px, 2vw, 28px) 0 var(--section-space);
  }

  h2 {
    margin: 0 0 28px;
    font-size: clamp(32px, 3.5vw, 44px);
    letter-spacing: -0.045em;
    text-align: left;
  }

  .home-service-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    gap: clamp(20px, 2.5vw, 30px);
  }

  .service-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 20px;
    align-content: start;
    align-items: start;
    gap: 20px 14px;
    border-radius: 14px;
  }

  picture {
    display: block;
    grid-column: 1 / -1;
    overflow: hidden;
    border-radius: 14px;
  }

  img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 14px;
    background: var(--paper-deep);
  }

  h3 {
    margin: 0 0 8px;
    font-size: clamp(21px, 2.2vw, 26px);
    line-height: 1.15;
    letter-spacing: -0.035em;
  }

  p {
    max-width: 32ch;
    margin: 0;
    font-size: 16px;
    line-height: 1.5;
  }

  .service-arrow {
    margin-top: 4px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .service-link:hover h3 {
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
  }

  .service-link:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 6px;
  }

  @media (max-width: 620px) {
    h2 { margin-bottom: 20px; }

    .home-service-links {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .service-link {
      grid-template-columns: 72px minmax(0, 1fr) 18px;
      align-items: center;
      gap: 16px;
      padding: 18px 0;
      border-bottom: 1px solid var(--hairline);
      border-radius: 0;
    }

    .service-link:first-child { border-top: 1px solid var(--hairline); }

    picture {
      grid-column: auto;
      width: 72px;
      height: 72px;
      border-radius: 10px;
    }

    img {
      width: 72px;
      height: 72px;
      aspect-ratio: 1;
      border-radius: 10px;
    }

    h3 {
      margin-bottom: 5px;
      font-size: 19px;
    }

    p {
      font-size: 14px;
      line-height: 1.4;
    }

    .service-arrow {
      width: 18px;
      height: 18px;
      margin: 0;
    }
  }
</style>
